# ==========================================
# Root & Monorepo Git Ignore
# ==========================================

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*.iml

# ==========================================
# Frontend (Next.js / Node.js)
# ==========================================
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Backend (Java / Spring Boot / Maven)
# ==========================================
target/
backend/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
